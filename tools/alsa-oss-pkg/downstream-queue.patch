+        q->completed_frames > q->submitted_frames ||
+        q->submitted_frames - q->completed_frames != q->queued_frames ||
+        q->queued_frames > q->capacity_frames + q->staging_frames)
+        return -EPIPE;
+    unsigned charged = q->capacity_frames - q->available_frames;
+    if (charged > io->buffer_size || charged > q->queued_frames ||
+        q->queued_frames - charged > q->staging_frames)
+        return -EPIPE;
+    return 0;
