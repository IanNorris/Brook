+	snd_pcm_uframes_t queued, position, delta;
+	snd_pcm_sframes_t result;
+	pthread_mutex_lock(&oss->lock);
+	result = oss_queue_locked(io, &queued);
+	if (result < 0)
+		goto out;
+	/* Native frames accepted by ALSA minus this stream's actual unfinished
+	 * frames gives completion, including a whole ring between queries. */
+	position = oss->expected_appl >= queued ? oss->expected_appl - queued :
+		oss->boundary - (queued - oss->expected_appl);
+	delta = position >= io->hw_ptr ? position - io->hw_ptr :
+		oss->boundary - (io->hw_ptr - position);
+	result = delta <= io->buffer_size ? (snd_pcm_sframes_t)position : -EPIPE;
+out:
+	pthread_mutex_unlock(&oss->lock);
+	return result;
+}
