+/* Called under the private mutex. ALSA serializes ordinary transfers and
+ * pointer calls; guard the accepted application origin against forward/rewind
+ * and software-only reset. Prepared configuration must be serialized by users. */
+static int oss_queue_locked(snd_pcm_ioplug_t *io, snd_pcm_uframes_t *queued)
+{
+	snd_pcm_oss_t *oss = io->private_data;
+	int bytes;
+	if (!oss->boundary || !oss->frame_bytes || !io->buffer_size)
+		return -EBADFD;
+	if (ioctl(oss->fd, SNDCTL_DSP_GETODELAY, &bytes) < 0)
+		return -errno;
+	if (bytes < 0 || (unsigned int)bytes % oss->frame_bytes)
+		return -EPIPE;
+	*queued = (unsigned int)bytes / oss->frame_bytes;
+	if (*queued > io->buffer_size)
+		return -EPIPE;
+	if (oss->expected_appl != io->appl_ptr) {
+		/* A software-only reset is safe only after the actual queue drains. */
+		if (!io->appl_ptr && !io->hw_ptr && !*queued)
+			oss->expected_appl = 0;
+		else
+			return -EPIPE;
+	}
+	return 0;
+}
 
