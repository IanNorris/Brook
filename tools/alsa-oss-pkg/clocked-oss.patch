+static int oss_delay(snd_pcm_ioplug_t *io, snd_pcm_sframes_t *delay)
+{
+	snd_pcm_oss_t *oss = io->private_data;
+	snd_pcm_uframes_t queued;
+	int result;
+	pthread_mutex_lock(&oss->lock);
+	result = oss_queue_locked(io, &queued);
+	if (!result)
+		*delay = queued;
+	pthread_mutex_unlock(&oss->lock);
+	return result;
 }
 
