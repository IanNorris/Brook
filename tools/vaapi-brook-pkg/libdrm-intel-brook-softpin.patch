+/* ---- Brook OS softpin VA allocator ---- */
+static int
+brook_va_insert(drm_intel_bufmgr_gem *g, int at, uint64_t start, uint64_t end)
+{
+	if (g->brook_va_count == g->brook_va_size) {
+		int n = g->brook_va_size ? g->brook_va_size * 2 : 64;
+		void *p = realloc(g->brook_va_free, n * sizeof(*g->brook_va_free));
+		if (!p)
+			return -ENOMEM;
+		g->brook_va_free = p;
+		g->brook_va_size = n;
+	}
+	memmove(&g->brook_va_free[at + 1], &g->brook_va_free[at],
+		(g->brook_va_count - at) * sizeof(*g->brook_va_free));
+	g->brook_va_free[at].start = start;
+	g->brook_va_free[at].end = end;
+	g->brook_va_count++;
+	return 0;
+}
+
+static uint64_t
+brook_va_alloc(drm_intel_bufmgr_gem *g, uint64_t size, uint64_t align)
+{
+	int i;
+	if (align < 4096)
+		align = 4096;
+	size = (size + 4095) & ~(uint64_t)4095;
+	for (i = 0; i < g->brook_va_count; i++) {
+		struct brook_va_range *r = &g->brook_va_free[i];
+		uint64_t start = (r->start + align - 1) & ~(align - 1);
+		if (start < r->start || start > r->end || r->end - start < size)
+			continue;
+		if (start != r->start) {
+			/* Keep the alignment gap as its own free range. */
+			uint64_t gap = r->start;
+			r->start = start;
+			if (brook_va_insert(g, i, gap, start))
+				return 0;
+			r = &g->brook_va_free[i + 1];
+		}
+		r->start += size;
+		if (r->start == r->end) {
+			int at = r - g->brook_va_free;
+			memmove(r, r + 1, (g->brook_va_count - at - 1) * sizeof(*r));
+			g->brook_va_count--;
+		}
+		return start;
+	}
+	return 0;
+}
+
+static void
+brook_va_free_range(drm_intel_bufmgr_gem *g, uint64_t start, uint64_t size)
+{
+	uint64_t end = start + size;
+	int i = 0;
+	while (i < g->brook_va_count && g->brook_va_free[i].start < start)
+		i++;
+	/* Coalesce with the previous and next free ranges. */
+	if (i > 0 && g->brook_va_free[i - 1].end == start) {
+		g->brook_va_free[i - 1].end = end;
+		if (i < g->brook_va_count && g->brook_va_free[i].start == end) {
+			g->brook_va_free[i - 1].end = g->brook_va_free[i].end;
+			memmove(&g->brook_va_free[i], &g->brook_va_free[i + 1],
+				(g->brook_va_count - i - 1) * sizeof(*g->brook_va_free));
+			g->brook_va_count--;
+		}
+		return;
+	}
+	if (i < g->brook_va_count && g->brook_va_free[i].start == end) {
+		g->brook_va_free[i].start = start;
+		return;
+	}
+	(void)brook_va_insert(g, i, start, end);
+}
+
+/* Caller holds bufmgr_gem->lock. Gives the BO a softpinned VA (or keeps a
+ * suitably aligned one it already has). Returns 0 or a negative errno. */
+static int
+brook_va_assign(drm_intel_bufmgr_gem *g, drm_intel_bo_gem *bo_gem)
+{
+	drm_intel_bo *bo = &bo_gem->bo;
+	uint64_t align = bo->align > 4096 ? bo->align : 4096, va;
+
+	if (!g->brook_softpin)
+		return 0;
+	/* A BO reused from the cache keeps its VA, but unreference_final
+	 * cleared kflags: re-establish the pin below. */
+	if (bo_gem->brook_va_size && (bo_gem->brook_va & (align - 1)) != 0)
+		brook_va_release(g, bo_gem);
+	if (bo_gem->brook_va_size) {
+		va = bo_gem->brook_va;
+	} else {
+		va = brook_va_alloc(g, bo->size, align);
+		if (!va)
+			return -ENOSPC;
+		bo_gem->brook_va = va;
+		bo_gem->brook_va_size = (bo->size + 4095) & ~(uint64_t)4095;
+	}
+	bo->offset64 = va;
+	bo->offset = va;
+	bo_gem->kflags |= EXEC_OBJECT_PINNED;
+	if (va + bo_gem->brook_va_size > (1ull << 32))
+		bo_gem->kflags |= EXEC_OBJECT_SUPPORTS_48B_ADDRESS;
+	return 0;
+}
+
+static void
+brook_va_release(drm_intel_bufmgr_gem *g, drm_intel_bo_gem *bo_gem)
+{
+	if (!bo_gem->brook_va_size)
+		return;
+	brook_va_free_range(g, bo_gem->brook_va, bo_gem->brook_va_size);
+	bo_gem->brook_va = bo_gem->brook_va_size = 0;
+	bo_gem->kflags &= ~(uint64_t)EXEC_OBJECT_PINNED;
+}
+
+static void
+brook_softpin_init(drm_intel_bufmgr_gem *g)
+{
+	const char *env = getenv("BROOK_LIBDRM_SOFTPIN");
+	const char *high = getenv("BROOK_LIBDRM_SOFTPIN_48B");
+	if (env && !strcmp(env, "0"))
+		return;
+	/* Default: [1 MiB, 4 GiB) so 32-bit relocation fields in i965 (which
+	 * writes bo->offset + delta itself) stay valid. BROOK_LIBDRM_SOFTPIN_48B=1
+	 * places every BO at or above 4 GiB to exercise 48-bit addressing. */
+	if (high && !strcmp(high, "1")) {
+		g->brook_va_base = 1ull << 32;
+		g->brook_va_limit = 1ull << 47;
+	} else {
+		g->brook_va_base = 1ull << 20;
+		g->brook_va_limit = (1ull << 32) - 4096;
+	}
+	g->brook_va_count = 0;
+	if (brook_va_insert(g, 0, g->brook_va_base, g->brook_va_limit))
+		return;
+	g->brook_softpin = true;
+}
+
+/* Y tiles are 128 bytes x 32 rows of 16-byte columns; X tiles 512 x 8. */
+static void
+brook_tile_copy(uint8_t *tiled, uint8_t *linear, uint32_t mode, uint32_t stride,
+		uint64_t size, bool to_linear)
+{
+	uint64_t rows = size / stride, y, x;
+	for (y = 0; y < rows; y++) {
+		if (mode == I915_TILING_Y) {
+			uint64_t tile_row = (y / 32) * (stride / 128) * 4096 + (y % 32) * 16;
+			for (x = 0; x < stride; x += 16) {
+				uint8_t *t = tiled + tile_row + (x / 128) * 4096 + ((x % 128) / 16) * 512;
+				uint8_t *l = linear + y * stride + x;
+				if (to_linear) memcpy(l, t, 16); else memcpy(t, l, 16);
+			}
+		} else {
+			uint64_t tile_row = (y / 8) * (stride / 512) * 4096 + (y % 8) * 512;
+			for (x = 0; x < stride; x += 512) {
+				uint8_t *t = tiled + tile_row + (x / 512) * 4096;
+				uint8_t *l = linear + y * stride + x;
+				if (to_linear) memcpy(l, t, 512); else memcpy(t, l, 512);
+			}
+		}
+	}
+}
+
+static bool
+brook_needs_shadow(drm_intel_bufmgr_gem *g, drm_intel_bo_gem *bo_gem)
+{
+	return g->brook_softpin && bo_gem->tiling_mode != I915_TILING_NONE;
+}
