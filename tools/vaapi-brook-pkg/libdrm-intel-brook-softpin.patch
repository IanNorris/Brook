+/* Caller holds bufmgr_gem->lock. Brook OS: GEM_MMAP first, then the
+ * MMAP_OFFSET (write-back) path for kernels without legacy GEM_MMAP. */
+static int
+brook_cpu_mapping(drm_intel_bufmgr_gem *bufmgr_gem, drm_intel_bo_gem *bo_gem)
+{
+	struct drm_i915_gem_mmap mmap_arg;
+	struct drm_i915_gem_mmap_offset off;
+	void *p;
+
+	if (bo_gem->mem_virtual)
+		return 0;
+	memclear(mmap_arg);
+	mmap_arg.handle = bo_gem->gem_handle;
+	mmap_arg.size = bo_gem->bo.size;
+	if (drmIoctl(bufmgr_gem->fd, DRM_IOCTL_I915_GEM_MMAP, &mmap_arg) == 0) {
+		bo_gem->mem_virtual = (void *)(uintptr_t)mmap_arg.addr_ptr;
+		return 0;
+	}
+	memclear(off);
+	off.handle = bo_gem->gem_handle;
+	off.flags = I915_MMAP_OFFSET_WB;
+	if (drmIoctl(bufmgr_gem->fd, DRM_IOCTL_I915_GEM_MMAP_OFFSET, &off))
+		return -errno;
+	p = drm_mmap(0, bo_gem->bo.size, PROT_READ | PROT_WRITE, MAP_SHARED, bufmgr_gem->fd, off.offset);
+	if (p == MAP_FAILED)
+		return -errno;
+	bo_gem->mem_virtual = p;
+	return 0;
+}
