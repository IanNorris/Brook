+/*
+ * Brook frametime bar-graph overlay (cl_frametimegraph). A renderer-agnostic
+ * reimplementation of the old software-port overlay (swimp_brook.c) using
+ * yquake2's 2D Draw API, so it works identically on gl1/gl3/gles3/soft.
+ *
+ * Keeps a 256-frame ring of frame intervals and draws, in the top-right:
+ *   - a text line "FPS N  X.X ms" (mean over the ring)
+ *   - a colour-coded bar graph, full-scale 33 ms (30 Hz): bars taller and
+ *     redder as frames get slower. Colour indices are the same palette entries
+ *     the engine's own netgraph uses (0x40 neutral, 0xd0 / 0xdf red).
+ */
+#define SCR_FT_HIST 256
+void
+SCR_DrawFrametimeGraph(void)
+{
+	static int   ft_us[SCR_FT_HIST];
+	static int   ft_head = 0;
+	static long long ft_lasttime = 0;
+
+	if (!cl_frametimegraph || cl_frametimegraph->value < 1)
+	{
+		/* Keep the clock fresh so the first frame after enabling isn't a
+		 * huge spike. */
+		ft_lasttime = Sys_Microseconds();
+		return;
+	}
+
+	long long now = Sys_Microseconds();
+	if (ft_lasttime != 0)
+	{
+		int dt = (int)(now - ft_lasttime);
+		if (dt < 0) dt = 0;
+		ft_us[ft_head] = dt;
+		ft_head = (ft_head + 1) % SCR_FT_HIST;
+	}
+	ft_lasttime = now;
+
+	/* Mean frame time over the populated ring. */
+	long long sum = 0;
+	int num = 0;
+	for (int i = 0; i < SCR_FT_HIST; i++)
+	{
+		if (ft_us[i] > 0) { sum += ft_us[i]; num++; }
+	}
+	float mean_ms = num ? ((float)sum / (float)num) / 1000.0f : 0.0f;
+	int fps = (mean_ms > 0.01f) ? (int)(1000.0f / mean_ms + 0.5f) : 0;
+	if (fps > 999) fps = 999;
+
+	float scale = SCR_GetConsoleScale();
+	if (scale < 1.0f) scale = 1.0f;
+
+	/* Layout: bar graph pinned to the top-right, text above it. */
+	int barW   = (viddef.width >= 1280) ? 2 : 1;
+	int graphH = (int)(40 * scale);
+	int graphW = SCR_FT_HIST * barW;
+	int pad    = (int)(4 * scale);
+	int textH  = (int)(8 * scale);
+
+	if (viddef.width < graphW + pad * 2 || viddef.height < graphH + textH + pad * 3)
+	{
+		return; /* screen too small — skip rather than draw off-screen */
+	}
+
+	int gx = viddef.width - graphW - pad;
+	int gy = pad + textH + pad;
+
+	/* Header text. */
+	char str[32];
+	snprintf(str, sizeof(str), "FPS %d  %.1f ms", fps, mean_ms);
+	DrawStringScaled(gx, pad, str, scale);
+
+	/* Graph background. */
+	Draw_Fill(gx, gy, graphW, graphH, 8);
+
+	/* Full-scale = 33 ms (30 Hz) -> 33000 us. */
+	for (int i = 0; i < SCR_FT_HIST; i++)
+	{
+		int idx = (ft_head + i) % SCR_FT_HIST;
+		int us  = ft_us[idx];
+		if (us <= 0) continue;
+
+		int bar = (us * graphH) / 33000;
+		if (bar > graphH) bar = graphH;
+
+		int color = (us > 33000) ? 0xdf : (us > 20000) ? 0xd0 : 0x40;
+
+		Draw_Fill(gx + i * barW, gy + graphH - bar, barW, bar, color);
+	}
+
+	SCR_AddDirtyPoint(gx, pad);
+	SCR_AddDirtyPoint(gx + graphW, gy + graphH);
+}
