+#ifdef QT5_HAS_WAYLAND
+bool VideoWidget::refreshWaylandHandle()
+{
+    if( !stable || !p_window || p_window->type != VOUT_WINDOW_TYPE_WAYLAND )
+        return false;
+    QWindow *window = stable->windowHandle();
+    QPlatformNativeInterface *qni = qApp->platformNativeInterface();
+    if( !window || !qni )
+        return false;
+    window->create();
+    void *surface = qni->nativeResourceForWindow(QByteArrayLiteral("surface"), window);
+    void *display = qni->nativeResourceForIntegration(QByteArrayLiteral("wl_display"));
+    if( !surface || !display )
+        return false;
+
+    /* Qt's stack changes can hide/recreate a native child. Compare only the
+     * saved pointer value; the former surface may already have been freed. */
+    msg_Dbg( p_intf, "Wayland surface handoff: %p -> %p",
+             static_cast<void*>(p_window->handle.wl), surface );
+    p_window->handle.wl = static_cast<wl_surface*>(surface);
+    p_window->display.wl = static_cast<wl_display*>(display);
+    return true;
+}
+#endif
 
