#!/usr/bin/env python3
"""Rebuild the per-user launcher manifest from installed desktop entries.

  brook-apps-index            rebuild once (notify the desktop if it changed)
  brook-apps-index --watch    rebuild whenever an entry directory changes
  brook-apps-index --print    show what would be indexed, write nothing
"""
import argparse
import sys
import time
from pathlib import Path

import brook_apps


def fingerprint():
    state = []
    for d in brook_apps.entry_dirs():
        try:
            state.append((str(d), d.stat().st_mtime_ns,
                          tuple(sorted((p.name, p.stat().st_mtime_ns) for p in d.glob('*.desktop')))))
        except OSError:
            state.append((str(d), None, ()))
    return state


def rebuild(verbose=False):
    lines, icons, skipped = brook_apps.build_index()
    changed = brook_apps.write_index(lines, icons)
    if changed:
        brook_apps.notify()
    if verbose or changed:
        print(f'brook-apps-index: {len(lines)} apps, {len(skipped)} skipped' + (' (updated)' if changed else ''))
        for path, why in skipped:
            print(f'  skipped {path}: {why}')
    return changed


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--watch', action='store_true')
    ap.add_argument('--print', action='store_true', dest='dry')
    ap.add_argument('--interval', type=float, default=3.0)
    a = ap.parse_args()
    if a.dry:
        lines, _, skipped = brook_apps.build_index()
        print('\n'.join(lines))
        for path, why in skipped:
            print(f'# skipped {path}: {why}', file=sys.stderr)
        return 0
    rebuild(verbose=True)
    if not a.watch:
        return 0
    last = fingerprint()
    while True:
        time.sleep(a.interval)
        now = fingerprint()
        if now != last:
            last = now
            try:
                rebuild()
            except Exception as e:  # keep watching; a half-written entry settles
                print(f'brook-apps-index: {e}', file=sys.stderr)


if __name__ == '__main__':
    sys.exit(main())
