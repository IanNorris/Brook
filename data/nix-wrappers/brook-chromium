#!/nix/profile/bin/bash
# Experimental Wayland browser; Chromium's sandbox is unsupported.
set -eu
if [ "$EUID" -eq 0 ]; then
  echo 'brook-chromium: launch from Applications or use: run --uid 1000 /nix/bin/brook-chromium [URLs...]' >&2
  exit 64
fi
export HOME=/data/home
export XDG_CONFIG_HOME=$HOME/.config XDG_CACHE_HOME=$HOME/.cache
export XDG_DATA_HOME=$HOME/.local/share
export TMPDIR=$XDG_CACHE_HOME/chromium-brook/tmp
# Preserve the older root-run profile; this state belongs to the desktop user.
# BROOK_CHROMIUM_PROFILE selects another profile (tests use a private one).
profile=${BROOK_CHROMIUM_PROFILE:-$XDG_CONFIG_HOME/chromium-brook}
mkdir -p "$profile" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$TMPDIR"
# Retain access to preferences saved by earlier launches using the keyfile
# backend. The desktop profile supplies the default layout.
if [[ ${GSETTINGS_BACKEND:-memory} == memory &&
      -r "$XDG_CONFIG_HOME/glib-2.0/settings/keyfile" ]]; then
  export GSETTINGS_BACKEND=keyfile
fi
unset DISPLAY
# GPU rendering through the opt-in patched Iris stack (ANGLE on GLES: GPU
# compositing and rasterization on the HD 5500). Video decode stays in software:
# Brook has no VA-API backend. BROOK_BROWSER_SOFTWARE=1, or an image without
# brook-iris-run, keeps the previous software configuration.
gpu=("${BROOK_IRIS_RUN:-/nix/profile/bin/brook-iris-run}")
flags=(--use-gl=angle --use-angle=gles --ignore-gpu-blocklist
       --disable-features=Vulkan --disable-accelerated-video-decode)
if [ -n "${BROOK_BROWSER_SOFTWARE:-}" ] || [ ! -x "${gpu[0]}" ]; then gpu=(); flags=(--disable-gpu); fi
# Opt-in VA-API decode (H.264/VP8/MPEG-2 on the Broadwell VCS). Needs a kernel
# with the video engine built, `gpu video on` plus a passing self-test this boot
# (HAS_BSD=1), and the staged brook-vaapi package (i965 with the static softpin
# libdrm_intel). Off by default: per-job VCS cost still makes it slower than
# software decode (docs/bdw-video-engine.md, phase 3/4).
if [ -n "${BROOK_CHROMIUM_VAAPI:-}" ] && [ -n "${gpu[*]}" ] && [ -d "${BROOK_VAAPI_DRIVERS:-}" ]; then
  export LIBVA_DRIVER_NAME=i965 LIBVA_DRIVERS_PATH="$BROOK_VAAPI_DRIVERS"
  flags=(--use-gl=angle --use-angle=gles --ignore-gpu-blocklist
         --enable-features=VaapiVideoDecoder,VaapiIgnoreDriverChecks,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL
         --disable-features=Vulkan,UseChromeOSDirectVideoDecoder
         --render-node-override="${BROOK_VAAPI_NODE:-/dev/dri/renderD129}")
fi
exec /nix/profile/bin/brook-run "${gpu[@]}" /nix/profile/bin/chromium \
  --no-sandbox "${flags[@]}" --disable-background-networking \
  --disable-component-update --disable-extensions --renderer-process-limit=2 \
  --disable-crash-reporter --no-first-run --no-default-browser-check \
  --ozone-platform=wayland --user-data-dir="$profile" "$@"
