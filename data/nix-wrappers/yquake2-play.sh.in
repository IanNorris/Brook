#!@BASH_BIN@
# Launch the nix-installed Yamagi Quake II (yquake2) on Brook's virgl GL stack.
#
# NOTE: this is a TEMPLATE / reference. The authoritative wrapper is GENERATED by
# scripts/prestage_yquake2.sh, which substitutes the real yquake2 store path into
# the final `exec` line, exactly the way nix-install generates stk-play.sh /
# gltron-play.sh. Do NOT use a command-substitution lookup here: on Brook a
# $(...) subshell re-execs bash and fails with "cannot execute binary file"
# (exit 126). The proven wrappers exec an absolute store path directly — match
# that.
#
# yquake2 is SDL2-based and dlopen()s its renderer (ref_gl1.so / ref_gl3.so /
# ref_gles3.so / ref_soft.so) from its own lib dir, picked by the `vid_renderer`
# cvar. We add the Brook virgl env (force the Mesa virtio_gpu DRI driver + glvnd
# EGL vendor dir, matching stk-play.sh / gltron-play.sh), SDL Wayland video, a
# dummy SDL audio backend, and a writable HOME for yquake2's ~/.yq2 config +
# savegames. The game data is read-only and SHARED with the native software port
# (/data/games/quake2/baseq2/pak0.pak), passed via -datadir.
#
# IMPORTANT: these launchers run yquake2 as uid 1000 (yquake2 refuses to run as
# root). The ext2 /data mount enforces DAC, so HOME=/data/yq2 must be a
# uid-1000-OWNED directory — prestage_yquake2.sh creates it (like /data/tmp).
# A root-owned HOME makes yquake2 fail with "Couldn't create dir /data/yq2/.yq2/".
export MESA_LOADER_DRIVER_OVERRIDE=virtio_gpu
export LIBGL_DRIVERS_PATH=@MESA_PATH@/lib/dri
export GBM_BACKENDS_PATH=@MESA_PATH@/lib/gbm
export __EGL_VENDOR_LIBRARY_DIRS=@MESA_PATH@/share/glvnd/egl_vendor.d
export SDL_VIDEODRIVER=wayland

# Audio: yquake2 uses OpenAL by default (cvar s_openal 1) and dlopen()s
# libopenal.so.1. The Brook OSS build of openal-soft (staged first on
# LD_LIBRARY_PATH by prestage_yquake2.sh) drives Brook's /dev/dsp OSS device,
# which is backed by the kernel audio mixer + Intel HDA driver. Hard-set
# ALSOFT_DRIVERS=oss (exactly "oss", not appended) so openal does NOT enumerate
# pulse/alsa/pipewire — those have no server on Brook and would block on connect
# timeouts. ALSOFT_CONF pins the output format to 44100/int16/stereo so the
# kernel mixer does NO resample (openal otherwise defaults to 48 kHz), and gives
# the mixer thread a little buffering slack (periods/period_size) to ride out GL
# frame spikes. SDL's own audio subsystem is unused in the OpenAL path.
export ALSOFT_DRIVERS=oss
export HOME=/data/yq2
export XDG_CACHE_HOME=/data/yq2/.cache
export XDG_CONFIG_HOME=/data/yq2/.config
mkdir -p /data/yq2/.yq2/baseq2 /data/yq2/.cache /data/yq2/.config

# Yamagi's bundled yq2.cfg defaults to ESDF (D=back). Use WASD for a fresh
# Brook profile, while leaving saved config/autoexec preferences authoritative.
BROOK_FIRST_CONTROLS=0
if [ ! -f "$HOME/.yq2/baseq2/config.cfg" ] && [ ! -f "$HOME/.yq2/baseq2/autoexec.cfg" ]; then
    BROOK_FIRST_CONTROLS=1
fi
# Installed by create_experiment_disks.py; guest directory creation can lose
# newly written files, so the mixer format must not depend on a startup heredoc.
export ALSOFT_CONF=/nix/etc/alsoft-oss.conf

# Library search path for libs yquake2 dlopen()s by bare soname that aren't on
# its rpath — notably libopenal.so.1 (OpenAL backend). @YQUAKE2_LIBDIRS@ is filled
# in by prestage_yquake2.sh with the openal-soft lib dir (+ the renderer dir as a
# belt-and-suspenders fallback). The GL renderers are found relative to the
# binary (see the exec note below); the GL libs themselves are on the renderer
# .so's own rpath (glvnd), so no extra path is needed for them.
export LD_LIBRARY_PATH="@YQUAKE2_LIBDIRS@${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# First positional arg selects the renderer (default gl1); the rest pass through.
# `case`/`shift` are builtins — no subshell, no fork (unlike $(command -v ...)).
RENDERER="gl1"
case "${1:-}" in
    gl1|gl3|gles3|soft) RENDERER="$1"; shift ;;
esac

if [ "$BROOK_FIRST_CONTROLS" = "1" ]; then
    set -- +exec brook-controls.cfg "$@"
fi

# @YQUAKE2_BIN@ is replaced by prestage_yquake2.sh with the RESOLVED real binary
# path (lib/yquake2/quake2), NOT the bin/yquake2 symlink. yquake2 finds its
# renderer .so's (ref_gl1.so etc.) relative to its own location, which it derives
# from /proc/self/exe -> the process exePath. Brook reports exePath as the path
# that was exec'd; if we exec'd the bin/ symlink, exePath would be .../bin/yquake2
# and yquake2 would look for renderers in bin/ (where they are NOT — they live in
# lib/yquake2/ next to the real binary), failing with "Library ref_gl1.so cannot
# be found!". Exec'ing the real path makes binarydir = lib/yquake2/ so the
# renderers are found.
# -datadir points at the shared baseq2 data (yquake2 deprecates +set basedir);
# vid_renderer selects GL vs software. al_driver is forced to a BARE soname
# (libopenal.so.1, now on LD_LIBRARY_PATH above) instead of the absolute store
# path nixpkgs bakes in (yquake2 rejects al_driver containing '/'). s_openal 1
# forces the OpenAL backend (the OSS path) even if a persisted config.cfg set it
# to 0, so audio is deterministic regardless of prior settings.
# +set logfile 2 forces yquake2 to write a FLUSHED qconsole.log (value 2 =
# fflush every line) under $HOME/.yq2/baseq2/. This is a diagnostic: yquake2
# exits right after creating its wayland window and its Sys_Error message is in
# the block-buffered serial tail that is lost when the process exits, so the
# serial console never shows WHY. With a per-line-flushed logfile the exit
# reason survives the crash. ext2 write-persistence on /data is verified working
# (a plain echo>file;cat round-trips), so the log will actually contain data.
exec @YQUAKE2_BIN@ -datadir /data/games/quake2 \
    +set al_driver libopenal.so.1 +set s_openal 1 +set logfile 2 \
    +set vid_renderer "$RENDERER" "$@"
