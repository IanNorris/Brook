#!/nix/store/4bwbk4an4bx7cb8xwffghvjjyfyl7m2i-bash-interactive-5.3p9/bin/bash
# Launch the nix-installed Yamagi Quake II (yquake2) on Brook's virgl GL stack.
#
# NOTE: this is a TEMPLATE / reference. The authoritative wrapper is GENERATED by
# scripts/prestage_yquake2.sh, which substitutes the real yquake2 store path into
# the final `exec` line, exactly the way nix-install generates stk-play.sh /
# gltron-play.sh. Do NOT use a command-substitution lookup here: on Brook a
# $(...) subshell re-execs bash and fails with "cannot execute binary file"
# (exit 126). The proven wrappers exec an absolute store path directly — match
# that.
#
# yquake2 is SDL2-based and dlopen()s its renderer (ref_gl1.so / ref_gl3.so /
# ref_gles3.so / ref_soft.so) from its own lib dir, picked by the `vid_renderer`
# cvar. We add the Brook virgl env (force the Mesa virtio_gpu DRI driver + glvnd
# EGL vendor dir, matching stk-play.sh / gltron-play.sh), SDL Wayland video, a
# dummy SDL audio backend, and a writable HOME for yquake2's ~/.yq2 config +
# savegames. The game data is read-only and SHARED with the native software port
# (/data/games/quake2/baseq2/pak0.pak), passed via -datadir.
#
# IMPORTANT: these launchers run yquake2 as uid 1000 (yquake2 refuses to run as
# root). The ext2 /data mount enforces DAC, so HOME=/data/yq2 must be a
# uid-1000-OWNED directory — prestage_yquake2.sh creates it (like /data/tmp).
# A root-owned HOME makes yquake2 fail with "Couldn't create dir /data/yq2/.yq2/".
export MESA_LOADER_DRIVER_OVERRIDE=virtio_gpu
export LIBGL_DRIVERS_PATH=/nix/store/b793hmy0383vxaax7hiaslzmizzd3pmg-mesa-26.0.6/lib/dri
export GBM_BACKENDS_PATH=/nix/store/b793hmy0383vxaax7hiaslzmizzd3pmg-mesa-26.0.6/lib/gbm
export __EGL_VENDOR_LIBRARY_DIRS=/nix/store/b793hmy0383vxaax7hiaslzmizzd3pmg-mesa-26.0.6/share/glvnd/egl_vendor.d
export SDL_VIDEODRIVER=wayland
export ALSOFT_DRIVERS=null
export SDL_AUDIODRIVER=dummy
export HOME=/data/yq2
mkdir -p /data/yq2/.yq2

# First positional arg selects the renderer (default gl1); the rest pass through.
# `case`/`shift` are builtins — no subshell, no fork (unlike $(command -v ...)).
RENDERER="gl1"
case "${1:-}" in
    gl1|gl3|gles3|soft) RENDERER="$1"; shift ;;
esac

# @YQUAKE2_BIN@ is replaced by the absolute store path by prestage_yquake2.sh.
# -datadir points at the shared baseq2 data (yquake2 deprecates +set basedir);
# vid_renderer selects GL vs software. al_driver is forced to a BARE soname:
# nixpkgs bakes an absolute /nix/store/.../libopenal.so.1 into the binary's
# default, which yquake2 rejects ("al_driver must not contain '/'"); audio is the
# SDL dummy backend here anyway (ALSOFT_DRIVERS=null), so this just silences the
# spurious OpenAL-init error.
exec @YQUAKE2_BIN@ -datadir /data/games/quake2 \
    +set al_driver libopenal.so.1 +set vid_renderer "$RENDERER" "$@"
