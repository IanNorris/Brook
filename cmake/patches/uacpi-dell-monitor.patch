+        const uacpi_u16 wait_ms = (uacpi_u16)((250000000 - elapsed + 999999) / 1000000);
+        const uacpi_bool notified =
+            uacpi_kernel_wait_for_event(g_uacpi_rt_ctx.global_lock_event, wait_ms);
         flags = uacpi_kernel_lock_spinlock(g_uacpi_rt_ctx.global_lock_spinlock);
+        if (!notified)
+            break;
     }
 
     g_uacpi_rt_ctx.global_lock_pending = UACPI_FALSE;
